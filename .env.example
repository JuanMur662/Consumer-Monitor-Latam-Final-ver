# =====================================================================
#  Copia este archivo como ".env" (setup.bat lo hace por ti) y completa.
#  Todos son GRATUITOS. Sin ellos el código funciona, pero omite esas fuentes.
# =====================================================================

# México: INEGI (IGAE, ventas minoristas EMEC, confianza empresarial y del consumidor)
#   Registro en 1 minuto: https://www.inegi.org.mx/app/desarrolladores/generatoken/Usuarios/token_Verify
INEGI_TOKEN=

# México: Banxico SIE (INPC y tasa objetivo; si falta se usa BIS)
#   https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=

# Chile: API del Banco Central (OPCIONAL: sin token se usan las tablas públicas de la BDE)
#   https://si3.bcentral.cl/estadisticas/Principal1/web_services/index.htm
BCCH_TOKEN=

# OPCIONAL: párrafo de síntesis por país en la hoja Noticias redactado por Claude
ANTHROPIC_API_KEY=

# OPCIONAL: proxy corporativo (si tu red lo exige). Ej: http://usuario:clave@proxy.empresa.com:8080
# HTTPS_PROXY=
# HTTP_PROXY=
