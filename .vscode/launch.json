{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Actualizar Monitor (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "monitor",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Vista previa (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "monitor",
      "args": ["--prueba"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
